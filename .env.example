# Copy to .env and fill in. NEVER commit .env. Secrets only — everything else is config.yaml.

# --- MQTT broker (Home Assistant) ---
# Your MQTT broker / HA host. If the broker runs on the same Docker host and this
# container uses bridge networking, use the host's LAN IP (not 127.0.0.1).
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=flightwatcher
MQTT_PASSWORD=changeme
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=flightwatcher

# --- Service ---
# TZ is also used by the scheduler; keep in sync with config.yaml scheduler.timezone.
TZ=Europe/Tallinn
LOG_LEVEL=INFO
# Host port the dashboard + API are published on (container always listens on 8080).
FW_PORT=8080
ENABLE_SCHEDULER=1

# --- Paths (usually leave as-is; Docker mounts ./data here) ---
DATA_DIR=/app/data
DEBUG_DIR=/app/data/debug

# --- Price source ---
# provider "serpapi" needs a free API key from https://serpapi.com (250 searches/mo
# free; we use ~60-120). Get the key, paste it here, and the watcher goes live.
SERPAPI_KEY=
# Override config.yaml scraper.provider if you want: serpapi | bangkok_airways
# FW_PROVIDER=serpapi

# Chromium mode (only used by the bangkok_airways provider). In Docker it must run
# HEADFUL under Xvfb (headless is blocked); leave false for the container.
FW_HEADLESS=false
